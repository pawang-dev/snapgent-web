{
  "manifest_version": 3,
  "name": "Snapgent Web",
  "version": "0.1.0",
  "description": "Lets an AI chat work on a local folder through the browser File System Access API.",
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open Snapgent panel" },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content/protocol.js", "content/claude.js"],
      "run_at": "document_idle"
    }
  ]
}
